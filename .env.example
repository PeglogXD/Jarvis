# J.A.R.V.I.S. — Configuración de API Keys
# Copia este archivo como .env y rellena tus claves.

# NVIDIA NIM (gratis en build.nvidia.com)
NVIDIA_API_KEY=

# Gemini (opcional, gratis en aistudio.google.com)
GEMINI_API_KEY=

# Pushbullet (opcional, para notificaciones)
PUSHBULLET_API_KEY=

# YouTube (opcional)
YOUTUBE_API_KEY=
